# PostgreSQL connection string (Neon, Supabase, or any Postgres instance).
# Neon/Supabase pooled connection strings work fine with Prisma's default settings.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="12h"

PORT=4000
NODE_ENV=development

# The deployed (or local) frontend origin, for CORS.
CORS_ORIGIN="http://localhost:5173"

# Password used for seeded users. Set this when running `npm run seed`.
# Example: export SEED_PASSWORD="your-temporary-password"
SEED_PASSWORD="replace-with-seed-password"
