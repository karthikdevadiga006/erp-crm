{
  "info": {
    "name": "ERP + CRM Operations Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "challanId", "value": "" },
    { "key": "seed_password", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@wholesaleco.test\",\n  \"password\": \"{{seed_password}}\"\n}"
            }
          }
        },
        {
          "name": "Get current user",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers",
          "request": { "method": "GET", "url": "{{baseUrl}}/customers?page=1&limit=20" }
        },
        {
          "name": "Search customers",
          "request": { "method": "GET", "url": "{{baseUrl}}/customers?search=Ramesh&status=ACTIVE" }
        },
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.id) { pm.collectionVariables.set('customerId', body.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ganesh Hardware\",\n  \"mobile\": \"9900112233\",\n  \"businessName\": \"Ganesh Hardware Stores\",\n  \"customerType\": \"RETAIL\",\n  \"status\": \"LEAD\",\n  \"address\": \"14 Market Street\"\n}"
            }
          }
        },
        {
          "name": "Get customer by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/customers/{{customerId}}" }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/customers/{{customerId}}",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" }
          }
        },
        {
          "name": "Add follow-up note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/customers/{{customerId}}/followups",
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Called — interested in bulk hinges order\"\n}" }
          }
        },
        {
          "name": "List follow-up notes",
          "request": { "method": "GET", "url": "{{baseUrl}}/customers/{{customerId}}/followups" }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": { "method": "GET", "url": "{{baseUrl}}/products?page=1&limit=20" }
        },
        {
          "name": "List low-stock products",
          "request": { "method": "GET", "url": "{{baseUrl}}/products?lowStock=true" }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.id) { pm.collectionVariables.set('productId', body.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PVC Pipe 2-inch\",\n  \"sku\": \"SKU-PVC-010\",\n  \"category\": \"Plumbing\",\n  \"unitPrice\": 210,\n  \"currentStock\": 150,\n  \"minStockAlert\": 30,\n  \"location\": \"Warehouse B - Rack 1\"\n}"
            }
          }
        },
        {
          "name": "Get product by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/products/{{productId}}",
            "body": { "mode": "raw", "raw": "{\n  \"unitPrice\": 225\n}" }
          }
        },
        {
          "name": "List stock movements",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}/movements" }
        },
        {
          "name": "Adjust stock (IN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/products/{{productId}}/stock-adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 50,\n  \"movementType\": \"IN\",\n  \"reason\": \"Purchase order #PO-1042 received\"\n}"
            }
          }
        },
        {
          "name": "Adjust stock (OUT, insufficient — expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/products/{{productId}}/stock-adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 999999,\n  \"movementType\": \"OUT\",\n  \"reason\": \"Testing insufficient stock guard\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "List challans",
          "request": { "method": "GET", "url": "{{baseUrl}}/challans?page=1&limit=20" }
        },
        {
          "name": "Filter challans by status",
          "request": { "method": "GET", "url": "{{baseUrl}}/challans?status=DRAFT" }
        },
        {
          "name": "Create challan (draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.id) { pm.collectionVariables.set('challanId', body.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/challans",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 5 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get challan by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/challans/{{challanId}}" }
        },
        {
          "name": "Update challan (draft only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/challans/{{challanId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 8 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Confirm challan",
          "request": { "method": "POST", "url": "{{baseUrl}}/challans/{{challanId}}/confirm" }
        },
        {
          "name": "Cancel challan",
          "request": { "method": "POST", "url": "{{baseUrl}}/challans/{{challanId}}/cancel" }
        }
      ]
    }
  ]
}
